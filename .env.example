# Django Gizli Anahtar (Canlıda benzersiz ve gizli tutulmalı)
SECRET_KEY=django-insecure-kararsizim-change-this-in-production-random-key-928374

# Hata ayıklama modu (Geliştirmede True, Canlıda False)
